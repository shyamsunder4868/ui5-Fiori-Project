<mvc:View
    controllerName="sap.com.task.employeemanagement.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <!-- FilterBar -->
            <fb:FilterBar
                id="filterbar"
                useToolbar="false"
                showClearOnFB="true"
                search="onFilterGo"
                clear="onClearFilters"
                showFilterConfiguration="false"
            >
                <fb:filterGroupItems>
                    <!-- Name SearchField -->
                    <fb:FilterGroupItem
                        name="name"
                        label="{i18n>name}"
                        groupName="Group1"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <SearchField
                                id="idNameFilter"
                                width="100%"
                                liveChange="onLiveNameSearch"
                                placeholder="{i18n>searchPlaceholder}"
                                tooltip="{i18n>searchPlaceholder}"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <!-- Status ComboBox -->
                    <fb:FilterGroupItem
                        name="status"
                        label="{i18n>status}"
                        groupName="Group1"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <ComboBox
                                id="idStatusFilter"
                                width="10%"
                                tooltip="{i18n>status}"
                            >
                                <core:Item
                                    key="Active"
                                    text="{i18n>active}"
                                    tooltip="{i18n>active}"
                                />
                                <core:Item
                                    key="Inactive"
                                    text="{i18n>inactive}"
                                    tooltip="{i18n>inactive}"
                                />
                            </ComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
            <!-- Action Buttons -->
            <HBox
                justifyContent="End"
                class="sapUiSmallMargin"
            >
                <Button
                    id="idAddButton"
                    text="{i18n>add}"
                    tooltip="{i18n>add}"
                    press="onAdd"
                    class="sapUiTinyMarginEnd"
                />
                <Button
                    id="idEditButton"
                    text="{i18n>edit}"
                    tooltip="{i18n>edit}"
                    press="onEdit"
                    class="sapUiTinyMarginEnd"
                />
                <Button
                    id="idDeleteButton"
                    text="{i18n>delete}"
                    tooltip="{i18n>delete}"
                    press="onDelete"
                    class="sapUiTinyMarginEnd"
                />
               
                <Button
                    text="{i18n>sortSalary}"
                    tooltip="{i18n>sortSalary}"
                    press="onSortSalary"
                />
            </HBox>
            <!-- Table -->
            <Table
                id="employeeTable"
                items="{/employees}"
                mode="SingleSelectLeft"
                headerText="{= ${i18n>title} + ' (' + ${/employees}.length + ')' }"
            >
                <columns>
                    <Column demandPopin="true">
                        <Text
                            text="{i18n>id}"
                            tooltip="{i18n>id}"
                        />
                    </Column>
                    <Column demandPopin="true">
                        <Text
                            text="{i18n>name}"
                            tooltip="{i18n>name}"
                        />
                    </Column>
                    <Column
                        demandPopin="true"
                        minScreenWidth="desktop"
                    >
                        <Text
                            text="{i18n>city}"
                            tooltip="{i18n>city}"
                        />
                    </Column>
                    <Column
                        demandPopin="true"
                        minScreenWidth="desktop"
                    >
                        <Text
                            text="{i18n>salary}"
                            tooltip="{i18n>salary}"
                        />
                    </Column>
                    <Column
                        demandPopin="true"
                        minScreenWidth="desktop"
                    >
                        <Text
                            text="{i18n>status}"
                            tooltip="{i18n>status}"
                        />
                    </Column>
                    <Column
                        demandPopin="true"
                        minScreenWidth="desktop"
                    >
                        <Text
                            text="{i18n>role}"
                            tooltip="{i18n>role}"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text
                                text="{id}"
                                tooltip="{id}"
                            />
                            <Text
                                text="{name}"
                                tooltip="{name}"
                            />
                            <Text
                                text="{city}"
                                tooltip="{city}"
                            />
                            <Text
                                text="{ path: 'salary', formatter: '.formatter.formatCurrency' }"
                                tooltip="{salary}"
                            />
                            <Text
                                text="{status}"
                                tooltip="{status}"
                            />
                            <Text
                                text="{role}"
                                tooltip="{role}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
